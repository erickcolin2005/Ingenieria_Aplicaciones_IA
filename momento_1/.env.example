# Plantilla de credenciales. Copiar a .env y llenar con las llaves propias.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac / Linux:           cp .env.example .env
#
# .env está en .gitignore y nunca se sube. Si una llave llega al repositorio,
# no basta con borrarla en un commit nuevo: hay que rotarla en el proveedor,
# porque el historial de git la conserva.
#
# Aclaración importante: EL PRODUCTO NO USA NINGUNA DE ESTAS LLAVES.
# reservas.html no hace peticiones de red ni habla con ningún modelo.
# Estas claves son de las herramientas con las que el equipo trabaja
# (pre-work de la semana 1: obtener acceso a una API con capa gratuita).

# Anthropic — capa de pruebas del equipo
ANTHROPIC_API_KEY=

# Google AI Studio — capa gratuita usada en la comparación de herramientas
GOOGLE_API_KEY=

# Groq — capa gratuita usada en la comparación de herramientas
GROQ_API_KEY=
