{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Edit(docs/**)",
      "Edit(producto/**)",
      "Edit(skills/**)",
      "Write(docs/**)",
      "Write(producto/**)",
      "Write(skills/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(node producto/pruebas.js)"
    ],
    "ask": [
      "Write(CLAUDE.md)",
      "Edit(CLAUDE.md)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./*.key)",
      "Read(./*.pem)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(Remove-Item:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pip install:*)",
      "Bash(npx:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "WebFetch"
    ]
  }
}
